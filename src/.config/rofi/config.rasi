configuration {
    modes: "drun";
    show-icons: true;
    terminal: "kitty";
    editor: "micro";
    matching: "regex";
    drun-display-format: "{name}";
    kb-mode-next: "Alt+Right";
    kb-mode-previous: "Alt+Left";
}

@theme "theme"

window {
    width: 520px;

    background-color: @bg0;

    border: 1px;
    border-color: @fg2;
}

mainbox {
    children: [ inputbar, message, listview ];
    padding: 12px;
    spacing: 10px;
}

inputbar {
    children: [ prompt, entry ];

    background-color: @bg0;

    padding: 2px 10px;
    spacing: 6px;
}

prompt {
    text-color: @accent;
    font: "JetBrains Mono Bold 12";
}

entry {
    placeholder: "Search…";
    placeholder-color: @fg2;
}

listview {
    lines: 8;
    spacing: 4px;
}

element {
    padding: 8px 10px;
    spacing: 8px;
}

element selected.normal {
    background-color: @fg1;
    text-color: @bg0;
}

element selected.active {
    background-color: @bg3;
    text-color: @cyan;
}

element selected.urgent {
    background-color: @bg3;
    text-color: @urgent;
}

message {
    background-color: @bg2;
    padding: 8px 12px;
}

textbox {
    text-color: @fg2;
    font: "JetBrains Mono Italic 12";
}